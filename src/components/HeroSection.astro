---
import apartment from '../data/apartment.json';
import imageMeta from '../data/images.json';
import { mediaLibrary } from '../data/media';
import ResponsiveImage from './ResponsiveImage.astro';
type ImageEntry = { asset: string; alt: string; ratio: string };

const imageCatalog = imageMeta as Record<string, ImageEntry>;
const heroMeta = imageCatalog[apartment.imageKeys.hero];
const heroImage = mediaLibrary[heroMeta.asset];
---

<section class="hero section" id="top">
  <div class="hero-shell">
    <div class="hero-image-wrap">
      <ResponsiveImage
        src={heroImage}
        alt={heroMeta.alt}
        widths={[960, 1280, 1600, 2200]}
        sizes="100vw"
        loading="eager"
        class="hero-image"
      />
    </div>

    <div class="container hero-content">
      <div class="hero-copy">
        <span class="eyebrow">Ferienwohnung · Ostsee</span>
        <h1>Ankern in Grömitz</h1>
        <div class="hero-meta">
          <p class="hero-place">{apartment.location}</p>
          <p>{apartment.tagline}</p>
        </div>
        <div class="actions">
          <a class="button" href="#verfuegbarkeit">Anfragen</a>
          <a class="action-link" href="#wohnung">Wohnung entdecken</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 0;
  }

  .hero-shell {
    position: relative;
    min-height: min(60rem, 100vh);
    background: #d9d3c8;
    isolation: isolate;
  }

  .hero-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(12, 27, 39, 0.66) 0%, rgba(12, 27, 39, 0.34) 38%, transparent 68%),
      linear-gradient(0deg, rgba(12, 27, 39, 0.25), transparent 46%);
  }

  .hero-content {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: center;
    padding-top: 6.2rem;
    padding-bottom: 3.2rem;
    z-index: 2;
  }

  .hero-copy {
    display: grid;
    gap: 1.15rem;
    width: min(42rem, calc(100vw - 2rem));
    padding: 0;
    color: #fff;
  }

  .hero-meta {
    display: grid;
    gap: 0.45rem;
    max-width: 25rem;
  }

  .hero-copy h1 {
    margin: 0;
    font-family: inherit;
    font-size: clamp(3.35rem, 6vw, 6.6rem);
    line-height: 0.88;
    letter-spacing: -0.06em;
    max-width: none;
    font-weight: 700;
    text-shadow: 0 2px 22px rgba(8, 18, 26, 0.25);
  }

  .hero-copy p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.98rem;
  }

  .hero-place {
    color: #fff;
    font-weight: 600;
  }

  .hero-copy :global(.eyebrow) {
    color: rgba(255, 255, 255, 0.72);
  }

  .hero-copy :global(.action-link) {
    color: #fff;
  }

  .hero-image-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-image-wrap :global(img.hero-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 960px) {
    .hero-content {
      align-items: end;
      padding-top: 7.5rem;
      padding-bottom: 4.2rem;
    }

    .hero-copy {
      width: min(42rem, 52vw);
    }
  }

  @media (max-width: 719px) {
    .hero-shell::after {
      background: linear-gradient(0deg, rgba(12, 27, 39, 0.78) 0%, rgba(12, 27, 39, 0.3) 53%, transparent 82%);
    }

    .hero-content {
      align-items: end;
      padding-bottom: 2.35rem;
    }

    .hero-copy h1 {
      font-size: clamp(3.05rem, 16vw, 4.35rem);
    }
  }
</style>
