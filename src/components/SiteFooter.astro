---
import apartment from '../data/apartment.json';

const basePath = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <span class="footer-kicker">Ferienwohnung in Grömitz</span>
      <strong>{apartment.name}</strong>
      <p>Ruhige Auszeit an der Lübecker Bucht.</p>
    </div>

  </div>

  <div class="container footer-meta">
    <span>© {new Date().getFullYear()} {apartment.name}</span>
    <nav aria-label="Rechtliches">
      <a href={`${basePath}impressum`} data-legal-dialog>Impressum</a>
      <a href={`${basePath}datenschutz`} data-legal-dialog>Datenschutz</a>
    </nav>
  </div>
</footer>

<dialog class="legal-dialog" data-legal-dialog-root aria-labelledby="legal-dialog-title">
  <div class="legal-dialog__header">
    <strong id="legal-dialog-title" data-legal-dialog-title>Rechtliches</strong>
    <button class="legal-dialog__close" type="button" data-legal-dialog-close aria-label="Dialog schließen">×</button>
  </div>
  <div class="legal-dialog__content" data-legal-dialog-content aria-live="polite"></div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-legal-dialog-root]');
  const content = dialog?.querySelector<HTMLElement>('[data-legal-dialog-content]');
  const title = dialog?.querySelector<HTMLElement>('[data-legal-dialog-title]');
  const close = dialog?.querySelector<HTMLButtonElement>('[data-legal-dialog-close]');

  document.querySelectorAll<HTMLAnchorElement>('[data-legal-dialog]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!dialog || !content || !title) return;
      event.preventDefault();
      title.textContent = link.textContent?.trim() || 'Rechtliches';
      content.setAttribute('aria-busy', 'true');
      content.innerHTML = '<p>Wird geladen …</p>';
      dialog.showModal();
      close?.focus();
      void fetch(link.href)
        .then((response) => response.text())
        .then((html) => {
          const source = new DOMParser().parseFromString(html, 'text/html').querySelector('.legal-sheet');
          content.innerHTML = source?.innerHTML ?? '<p>Der Inhalt konnte nicht geladen werden.</p>';
        })
        .catch(() => {
          content.innerHTML = '<p>Der Inhalt konnte nicht geladen werden. Bitte öffnen Sie den Link in einem neuen Tab.</p>';
        })
        .finally(() => content.removeAttribute('aria-busy'));
    });
  });

  close?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('close', () => { if (content) content.innerHTML = ''; });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .site-footer {
    padding: 4.5rem 0 1.6rem;
    background: #123e64;
    color: #f5f8fb;
  }

  .footer-main {
    display: grid;
    gap: 2.5rem;
  }

  .footer-brand {
    display: grid;
    gap: 0.65rem;
    max-width: 24rem;
  }

  .footer-kicker {
    color: #a9c2da;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .footer-brand strong {
    font-size: clamp(2rem, 4vw, 3.2rem);
    letter-spacing: -0.045em;
    line-height: 0.96;
  }

  .footer-brand p {
    margin: 0;
    color: #c6d5e3;
    font-size: 1rem;
  }

  .footer-meta a:hover,
  .footer-meta a:focus-visible {
    color: #a9c9f5;
  }

  .footer-meta {
    margin-top: 3.5rem;
    padding-top: 1.3rem;
    border-top: 1px solid rgba(224, 237, 248, 0.2);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    color: #a9c2da;
    font-size: 0.9rem;
  }

  .footer-meta nav {
    display: flex;
    gap: 1.25rem;
  }

  .footer-meta a {
    color: inherit;
    text-decoration: none;
  }

  .legal-dialog {
    width: min(48rem, calc(100vw - 2rem));
    height: min(48rem, calc(100dvh - 2rem));
    padding: 0;
    border: 0;
    border-radius: 0;
    background: var(--background);
    box-shadow: 0 1.5rem 5rem rgba(8, 20, 30, 0.28);
    overflow: hidden;
  }

  .legal-dialog::backdrop {
    background: rgba(7, 20, 30, 0.56);
    backdrop-filter: blur(0.2rem);
  }

  .legal-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    padding: 0 1rem 0 1.35rem;
    border-bottom: 1px solid var(--line);
    color: var(--text);
  }

  .legal-dialog__close {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }

  .legal-dialog__content {
    height: calc(100% - 4rem);
    box-sizing: border-box;
    padding: 1.6rem 1.35rem 2.5rem;
    overflow: auto;
    color: var(--text);
    line-height: 1.6;
  }

  .legal-dialog__content :global(h1) {
    margin: 0 0 1rem;
    font-family: inherit;
    font-weight: 700;
    font-size: clamp(2.25rem, 7vw, 4rem);
    line-height: 0.95;
  }

  .legal-dialog__content :global(h2) {
    margin: 2rem 0 0.5rem;
    font-size: 1.15rem;
  }

  .legal-dialog__content :global(p) {
    margin: 0 0 1rem;
    color: var(--text-soft);
  }

  .legal-dialog__content :global(section + section) {
    margin-top: 2rem;
  }

  .legal-dialog__content :global(a) {
    color: inherit;
  }

  @media (max-width: 640px) {
    .legal-dialog {
      width: 100vw;
      height: min(84dvh, 48rem);
      max-height: 84dvh;
      margin: auto 0 0;
      border-radius: 0;
    }
  }

  @media (min-width: 760px) {
    .footer-main {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
