---
import apartment from '../data/apartment.json';
import { Mail, Phone } from 'lucide';
import type { IconNode } from 'lucide';

const renderLucideIcon = (iconNode: IconNode) =>
  `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${iconNode
    .map(([tag, attrs]) => `<${tag} ${Object.entries(attrs)
      .filter(([, value]) => value !== undefined)
      .map(([key, value]) => `${key}="${String(value)}"`)
      .join(' ')}></${tag}>`)
    .join('')}</svg>`;
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <span class="footer-kicker">Ferienwohnung in Grömitz</span>
      <strong>{apartment.name}</strong>
      <p>Ruhige Auszeit an der Lübecker Bucht.</p>
    </div>

    <div class="footer-contact">
      <span class="footer-icon" set:html={renderLucideIcon(Phone)} />
      <div>
        <span class="footer-kicker">Telefon</span>
        <a href={`tel:${apartment.contact.phone.replaceAll(' ', '')}`}>{apartment.contact.phone}</a>
      </div>
    </div>

    <div class="footer-contact">
      <span class="footer-icon" set:html={renderLucideIcon(Mail)} />
      <div>
        <span class="footer-kicker">E-Mail</span>
        <a href={`mailto:${apartment.contact.email}`}>{apartment.contact.email}</a>
      </div>
    </div>
  </div>

  <div class="container footer-meta">
    <span>© {new Date().getFullYear()} {apartment.name}</span>
    <nav aria-label="Rechtliches">
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding: 4.5rem 0 1.6rem;
    background: #123e64;
    color: #f5f8fb;
  }

  .footer-main {
    display: grid;
    gap: 2.5rem;
  }

  .footer-brand {
    display: grid;
    gap: 0.65rem;
    max-width: 24rem;
  }

  .footer-kicker {
    color: #a9c2da;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .footer-brand strong {
    font-size: clamp(2rem, 4vw, 3.2rem);
    letter-spacing: -0.045em;
    line-height: 0.96;
  }

  .footer-brand p {
    margin: 0;
    color: #c6d5e3;
    font-size: 1rem;
  }

  .footer-contact {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.85rem;
  }

  .footer-contact > div {
    display: grid;
    gap: 0.45rem;
  }

  .footer-icon {
    display: inline-flex;
    width: 2.6rem;
    height: 2.6rem;
    color: #a9c9f5;
  }

  .footer-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .footer-contact a {
    color: #f5f8fb;
    font-size: 1.12rem;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer-contact a:hover,
  .footer-contact a:focus-visible,
  .footer-meta a:hover,
  .footer-meta a:focus-visible {
    color: #a9c9f5;
  }

  .footer-meta {
    margin-top: 3.5rem;
    padding-top: 1.3rem;
    border-top: 1px solid rgba(224, 237, 248, 0.2);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    color: #a9c2da;
    font-size: 0.9rem;
  }

  .footer-meta nav {
    display: flex;
    gap: 1.25rem;
  }

  .footer-meta a {
    color: inherit;
    text-decoration: none;
  }

  @media (min-width: 760px) {
    .footer-main {
      grid-template-columns: minmax(0, 1.25fr) repeat(2, minmax(0, 0.75fr));
      align-items: end;
      gap: 2rem;
    }
  }
</style>
