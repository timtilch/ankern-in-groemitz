---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  src,
  alt,
  widths = [480, 720, 960, 1280, 1600],
  sizes = '(min-width: 960px) 50vw, 100vw',
  loading = 'lazy',
  class: className
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={88}
  loading={loading}
  decoding="async"
  class={className}
/>
