---
import apartment from '../data/apartment.json';
import { Accessibility, CigaretteOff, Ruler, SquareParking, Umbrella, Wifi } from 'lucide';
import type { IconNode } from 'lucide';

const renderLucideIcon = (iconNode: IconNode) =>
  `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${iconNode
    .map(([tag, attrs]) => `<${tag} ${Object.entries(attrs)
      .filter(([, value]) => value !== undefined)
      .map(([key, value]) => `${key}="${String(value)}"`)
      .join(' ')}></${tag}>`)
    .join('')}</svg>`;

const factIcons: Record<string, string> = {
  WLAN: renderLucideIcon(Wifi),
  Wohnfläche: renderLucideIcon(Ruler),
  Terrasse: renderLucideIcon(Umbrella),
  Parkplatz: renderLucideIcon(SquareParking),
  Rauchfrei: renderLucideIcon(CigaretteOff),
  Barrierearm: renderLucideIcon(Accessibility)
};

const factDescriptions: Record<string, string> = {
  WLAN: 'Stabiles WLAN für Streaming, Homeoffice und schnelle Verbindungen im ganzen Apartment.',
  Wohnfläche: '58 m² Wohnfläche in einer modernisierten 2-Zimmer-Wohnung.',
  Terrasse: 'Privater Außenplatz mit ruhiger Atmosphäre und viel Licht für Frühstück oder Abendstunden.',
  Parkplatz: 'Ein fester Stellplatz direkt am Haus macht Anreise und Ausflüge entspannt und unkompliziert.',
  Rauchfrei: 'Das Domizil ist rauch- und haustierfrei.',
  Barrierearm: 'Leicht begehbare Dusche für einen komfortablen Aufenthalt.'
};
---

<section class="section quickfacts-section" id="wohnung">
  <div class="container quickfacts">
    <div class="quickfacts-copy">
      <span class="eyebrow">Ferienwohnung</span>
      <h2>
        <span>Ankommen.</span>
        <span>Abschalten.</span>
        <span>Wohlfühlen.</span>
      </h2>
      <p>{apartment.shortDescription}</p>
    </div>

    <ul class="facts-list" aria-label="Wohnungsdaten">
      {
        apartment.quickFacts.map((fact) => {
          const [head, ...rest] = fact.split(' ');
          return (
            <li>
              <span class="fact-icon" set:html={factIcons[head] ?? factIcons.WLAN} />
              <div class="fact-copy">
                <strong>{head}</strong>
                <p>{factDescriptions[head] ?? (rest.join(' ') || fact)}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .quickfacts-section {
    padding-top: var(--section-space);
  }

  .quickfacts {
    display: grid;
    gap: 1.6rem;
  }

  .quickfacts-copy {
    display: grid;
    gap: 1rem;
    max-width: 32rem;
  }

  .quickfacts-copy h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .quickfacts-copy h2 span {
    display: block;
  }

  .quickfacts-copy p {
    margin: 0;
    color: var(--text-soft);
    max-width: 26rem;
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .facts-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.6rem;
    align-self: start;
  }

  .facts-list li {
    padding: 0;
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }

  .fact-icon {
    display: inline-flex;
    width: 2.3rem;
    height: 2.3rem;
    color: var(--accent);
    opacity: 0.92;
  }

  .fact-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .fact-copy {
    display: grid;
    gap: 0.45rem;
  }

  .facts-list strong {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    font-weight: 700;
    line-height: 1.05;
    font-family: inherit;
  }

  .fact-copy p {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.55;
    font-size: 0.92rem;
  }

  @media (min-width: 960px) {
    .quickfacts {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
      align-items: start;
      gap: 2.6rem;
    }

    .facts-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.4rem 2.5rem;
    }
  }
</style>
