---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout title="Impressum | Ankern in Grömitz" pathname="/impressum">
  <main id="content" class="page-shell">
    <section class="section">
      <div class="container legal-sheet">
        <span class="eyebrow">Impressum</span>
        <h1>Impressum</h1>
        <section>
          <h2>Angaben gemäß § 5 DDG</h2>
          <p>
            Mathias Henning<br />
            Uferstraße 16<br />
            23743 Grömitz<br />
            Deutschland
          </p>
        </section>

        <section>
          <h2>Kontakt</h2>
          <p><a href="mailto:ankerningroemitz48@gmail.com">ankerningroemitz48@gmail.com</a></p>
        </section>

        <section>
          <h2>Umsatzsteuer</h2>
          <p>Gemäß § 19 UStG wird keine Umsatzsteuer ausgewiesen.</p>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .legal-sheet {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }

  .legal-sheet h1 {
    font-family: inherit;
    font-weight: 700;
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 0.92;
    margin: 0.75rem 0 1rem;
  }

  .legal-sheet p {
    margin: 0 0 1rem;
    color: var(--text-soft);
    max-width: 42rem;
  }

  .legal-sheet section + section {
    margin-top: 2rem;
  }

  .legal-sheet h2 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }

  .legal-sheet a {
    color: inherit;
  }
</style>
