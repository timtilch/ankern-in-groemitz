DATABASE_URL=postgresql://user:password@host:5432/database
ADMIN_PASSWORD=bitte-sicher-waehlen
GOOGLE_CLIENT_ID=deine-google-client-id
GOOGLE_CLIENT_SECRET=dein-google-client-secret
