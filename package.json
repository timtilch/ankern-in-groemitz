{
  "name": "ankern-in-groemitz",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n worker,site -c cyan,green \"npm:dev:worker\" \"npm:dev:site\"",
    "dev:worker": "cd worker && npx wrangler dev",
    "dev:site": "PUBLIC_API_BASE_URL=http://localhost:8787 astro dev --port 4321 --strictPort",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.12.0",
    "lucide": "^1.32.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.4",
    "typescript": "^5.9.2",
    "wrangler": "^4.34.0"
  }
}
